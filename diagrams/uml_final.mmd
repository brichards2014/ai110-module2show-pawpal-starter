classDiagram
    class Owner {
        +str name
        +List~Pet~ pets
        +add_pet(pet)
        +get_pet(name) Pet
        +get_all_tasks() List~Task~
        +to_dict() dict
        +from_dict(data) Owner
        +save_to_json(path)
        +load_from_json(path) Owner
    }
    class Pet {
        +str name
        +str species
        +List~Task~ tasks
        +add_task(task)
        +remove_task(task)
        +to_dict() dict
        +from_dict(data) Pet
    }
    class Task {
        +str description
        +str time
        +str frequency
        +int duration_minutes
        +str priority
        +date due_date
        +bool completed
        +str pet_name
        +mark_complete()
        +next_occurrence() Task
        +to_dict() dict
        +from_dict(data) Task
    }
    class Scheduler {
        +Owner owner
        +get_all_tasks() List~Task~
        +sort_by_time(tasks) List~Task~
        +sort_by_priority(tasks) List~Task~
        +filter_tasks(pet_name, completed) List~Task~
        +todays_schedule(on) List~Task~
        +mark_task_complete(task) Task
        +next_available_slot(duration_minutes, on, day_start, day_end) str
        +detect_conflicts() List~str~
    }
    Owner "1" --> "*" Pet : has
    Pet "1" --> "*" Task : has
    Scheduler --> Owner : reads from
    Scheduler ..> Task : creates next occurrence
